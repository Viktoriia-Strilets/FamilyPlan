
# ==========================================
# GENERAL SETTINGS
# ==========================================

APP_ENV=development
APP_TIMEZONE=Europe/Kyiv

# ==========================================
# JWT AUTHENTICATION
# ==========================================

SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==========================================
# DATABASE SETTINGS
# ==========================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

USER_DB_HOST=user-db
USER_DB_PORT=5432
USER_DB_NAME=user_db

BUDGET_DB_HOST=budget-db
BUDGET_DB_PORT=5432
BUDGET_DB_NAME=budget_db

SHOPPING_DB_HOST=shopping-db
SHOPPING_DB_PORT=5432
SHOPPING_DB_NAME=shopping_db

ANALYTICS_DB_HOST=analytics-db
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_NAME=analytics_db

# ==========================================
# MICROSERVICE COMMUNICATION
# ==========================================

BUDGET_SERVICE_URL=http://budget-service:8000
SHOPPING_SERVICE_URL=http://shopping-service:8000

INTERNAL_API_KEY=CHANGE_ME_TO_ANOTHER_RANDOM_SECRET

# ==========================================
# EMAIL / SMTP SETTINGS
# ==========================================

SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525

SMTP_USERNAME=YOUR_MAILTRAP_USERNAME
SMTP_PASSWORD=YOUR_MAILTRAP_PASSWORD

SMTP_FROM_EMAIL=familyplan@example.com
SMTP_FROM_NAME=FamilyPlan

SMTP_USE_TLS=true

# ==========================================
# EMAIL REMINDERS
# ==========================================

EMAIL_REMINDERS_ENABLED=true
REMINDER_CHECK_INTERVAL_MINUTES=60

# ==========================================
# GOOGLE OAUTH
# ==========================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/auth/google/callback
